entity = {
	name = "touhou_inhiborter_started_entity"
	pdxmesh = "touhou_inhiborter_mesh"
	default_state = "moving"
    locator = { name = "upper_core" position = { 0 100 0 } }
    locator = { name = "lower_core" position = { 0 -100 0 } }
	state = { name = "moving" state_time = 8 animation = "moving" looping = yes
        event = { time = 0.0 node = "joint2" particle = touhou_automate_inhibitor_working_effect trigger_once = yes keep_particle = yes }
        event = { time = 0.0 node = "joint3" particle = touhou_automate_inhibitor_working_effect trigger_once = yes keep_particle = yes }
        # event = { time = 0.0 node = "upper_core" particle = touhou_automate_inhibitor_working_small_effect keep_particle = yes }
        # event = { time = 0.0 node = "lower_core" particle = touhou_automate_inhibitor_working_small_effect keep_particle = yes }
        start_event = { sound = { soundeffect = hd2_automate_detector_action_effect } }
		# event = { trigger_once = yes sound = { soundeffect = hd2_automate_detector_action_effect } }
	}
    scale = 1.0
}

