#light_01-11 发光点
#moving 是旋转模型
#idle 是静止模型
entity = {
	name = "touhou_psionic_inhibitor_moving_entity"
	pdxmesh = "touhou_psionic_inhibitor_mesh"
    locator = { name = "root" 	position = { 0 0 0 } }
    locator = { name = "core" 	position = { 0 0 0 } }
    locator = { name = "beam_root" 	position = { 0 0 0 } }

	default_state = "moving"
	state = { name = "moving" animation = "moving" looping = yes animation_speed = 0.25 #速度
        start_event = { sound = { soundeffect = "amb_battleship_hum" } }
        start_event = { sound = { soundeffect = "amb_battleship_bass" } }
        event = { time = 0 node = "core" particle = "touhou_psionic_inhibitor_core_blue" keep_particle = yes trigger_once = yes }
        event = { time = 0 node = "beam_root" particle = "matde_platform_beam_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "light_01" particle = "touhou_psionic_inhibitor_sub_blue" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "light_02" particle = "touhou_psionic_inhibitor_sub_blue" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "light_03" particle = "touhou_psionic_inhibitor_sub_blue" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "light_04" particle = "touhou_psionic_inhibitor_sub_blue" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "light_05" particle = "touhou_psionic_inhibitor_sub_blue" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "light_06" particle = "touhou_psionic_inhibitor_sub_blue" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "light_07" particle = "touhou_psionic_inhibitor_sub_blue" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "light_08" particle = "touhou_psionic_inhibitor_sub_blue" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "light_09" particle = "touhou_psionic_inhibitor_sub_blue" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "light_10" particle = "touhou_psionic_inhibitor_sub_blue" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "light_11" particle = "touhou_psionic_inhibitor_sub_blue" keep_particle = yes trigger_once = yes }
	}
    scale = 0.20
}
entity = {
    name = "touhou_psionic_burster_moving_entity"
    pdxmesh = "touhou_psionic_burster_mesh"
    locator = { name = "root" 	position = { 0 0 0 } }
    locator = { name = "core" 	position = { 0 0 0 } }
    locator = { name = "beam_root" 	position = { 0 0 0 } }

    default_state = "moving"
    state = { name = "moving" animation = "moving" looping = yes animation_speed = 0.25 #速度
