@touhou_fe_union_titan_scale = 2.0

animation = { name = "touhou_fe_union_titan_idle_animation" file = "touhou_fe_union_titan_idle.anim" }
animation = { name = "touhou_fe_union_titan_death_animation" file = "touhou_fe_union_titan_death.anim" }

entity = {
    name = "touhou_fe_union_titan_teal_hull_entity"
    pdxmesh = "touhou_fe_union_titan_teal_mesh"
    scale = 1.0

    default_state = "idle"
    state = { name = "idle" animation = "idle" }
    state = { name = "death" animation = "death" looping = no
        event = { trigger_once = yes sound = { soundeffect = "amb_fallen_empire_titan_death" } }
        event = { time = 0 node = "explosion_locator1" particle = "th_explosion_green_small" trigger_once = yes keep_particle = yes sound = { soundeffect = "station_explosion_small" } }
        event = { time = 1 node = "explosion_locator2" particle = "th_explosion_green_small" trigger_once = yes keep_particle = yes sound = { soundeffect = "station_explosion_large" } }
        event = { time = 2 node = "explosion_locator3" particle = "th_explosion_green_small" trigger_once = yes keep_particle = yes sound = { soundeffect = "station_explosion_small" } }
        event = { time = 3 node = "explosion_locator4" particle = "th_explosion_green_small" trigger_once = yes keep_particle = yes sound = { soundeffect = "ship_destroyed_big_explosion" } }
    }

    game_data = { emissive_recolor_crunch = 0.0 }
}
entity = {
    name = "touhou_fe_union_titan_damaged_hull_entity"
    pdxmesh = "touhou_fe_union_titan_damaged_mesh"
    scale = @touhou_fe_union_titan_scale
    default_state = "idle"
    state = { name = "idle" animation = "idle" animation_speed = 0 }
    state = { name = "death" animation = "death" looping = no
        event = { trigger_once = yes sound = { soundeffect = "amb_fallen_empire_titan_death" } }
        event = { time = 0 node = "explosion_locator1" particle = "th_explosion_green_small" trigger_once = yes keep_particle = yes sound = { soundeffect = "station_explosion_small" } }
        event = { time = 1 node = "explosion_locator2" particle = "th_explosion_green_small" trigger_once = yes keep_particle = yes sound = { soundeffect = "station_explosion_large" } }
        event = { time = 2 node = "explosion_locator3" particle = "th_explosion_green_small" trigger_once = yes keep_particle = yes sound = { soundeffect = "station_explosion_small" } }
        event = { time = 3 node = "explosion_locator4" particle = "th_explosion_green_small" trigger_once = yes keep_particle = yes sound = { soundeffect = "ship_destroyed_big_explosion" } }
    }
    game_data = { emissive_recolor_crunch = 0.0 }
}