entity = {
	name = "toho_gunpower_main_entity"
	pdxmesh = "toho_gunpower_main_mesh"
	# 攻击点root 不要塞炮塔
    # idle 不展开的动画
    # idle2 不展开的动画
    # attacking 展开动画
	default_state = "idle"
	state = { name = "idle" animation = "idle"
        start_event = { trigger_once = yes sound = { soundeffect = "amb_star_eater_idle_hum" stop_on_state_change = yes } }
        start_event = { trigger_once = yes sound = { soundeffect = "amb_star_eater_idle_pulsating" stop_on_state_change = yes } }
        event = { time = 0 node = "root" particle = "toho_gunpower_energy_core_teal" keep_particle = yes trigger_once = yes }
    }
    state = { name = "moving" animation = "idle"
        start_event = { trigger_once = yes sound = { soundeffect = "amb_star_eater_idle_hum" stop_on_state_change = yes } }
        start_event = { trigger_once = yes sound = { soundeffect = "amb_star_eater_idle_pulsating" stop_on_state_change = yes } }
        event = { time = 0 node = "root" particle = "toho_gunpower_energy_core_teal" keep_particle = yes trigger_once = yes }
        event = { trigger_once = yes sound = { soundeffect = "sfx_star_eater_moving_out" } }
    }
	state = { name = "idle2" animation = "idle2"
        start_event = { trigger_once = yes sound = { soundeffect = "amb_star_eater_idle_hum" stop_on_state_change = yes } }
        start_event = { trigger_once = yes sound = { soundeffect = "amb_star_eater_idle_pulsating" stop_on_state_change = yes } }
        start_event = { trigger_once = yes sound = { soundeffect = "mega_shipyard_idle" stop_on_state_change = yes } }
        event = { time = 0 node = "root" particle = "toho_gunpower_energy_core_extra" keep_particle = yes trigger_once = yes }
    }
	state = { name = "attacking" animation = "attacking" looping = no
        start_event = { trigger_once = yes sound = { soundeffect = "amb_star_eater_idle_hum" stop_on_state_change = yes } }
        start_event = { trigger_once = yes sound = { soundeffect = "amb_star_eater_idle_pulsating" stop_on_state_change = yes } }
        start_event = { trigger_once = yes sound = { soundeffect = "amb_star_eater_open_energy" stop_on_state_change = yes } }
        event = { time = 0 node = "root" particle = "toho_gunpower_energy_core_teal" keep_particle = yes trigger_once = yes }
    }
    # open state death
    state = { name = "death" looping = no animation = "idle2"
        chance = {
            if_current_state = {
                "idle" = 0
                "attacking" = 0
                "moving" = 0
                "idle2" = 100
            }
        }
        event = { time = 0 node = "root" particle = "toho_gunpower_energy_core_extra" keep_particle = yes trigger_once = yes }
        event = { time = 0 node = "root" particle = "th_explosion_purple_large" keep_particle = yes trigger_once = yes }
        start_event = { trigger_once = yes sound = { soundeffect = "amb_super_explosion" } }
    }
    # close state death
    state = { name = "death" looping = no animation = "idle"
        chance = {
            if_current_state = {
                "idle" = 100
                "attacking" = 100
                "moving" = 100
                "idle2" = 0
            }
        }
        event = { time = 0 node = "root" particle = "toho_gunpower_energy_core_teal" keep_particle = yes trigger_once = yes }
        event = { time = 0 node = "root" particle = "th_explosion_green_large" keep_particle = yes trigger_once = yes }
        start_event = { trigger_once = yes sound = { soundeffect = "station_explosion_energy" } }
    }
    scale = 0.2
}
