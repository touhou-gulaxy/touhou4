entity = {
	name = "touhou_sky_control_ship_entity"
	pdxmesh = "arthropoid_01_titan_frame_mesh"
	default_state = "idle"
	scale = 1.0
	state = {
        name = "idle" animation = "idle"
        start_event = { trigger_once = yes sound = { soundeffect = "amb_star_eater_idle_hum" } }
        start_event = { trigger_once = yes sound = { soundeffect = "amb_star_eater_idle_pulsating" } }
        start_event = { trigger_once = yes sound = { soundeffect = "amb_megastructure_quantum_catapult_level_01_idle" } }
        start_event = { trigger_once = yes sound = { soundeffect = "amb_megastructure_quantum_catapult_level_02_idle" } }
        start_event = { trigger_once = yes sound = { soundeffect = "amb_megastructure_quantum_catapult_level_03_idle" } }
	}
	state = { name = "moving" animation = "idle"
		event =  { trigger_once = yes sound = { soundeffect = "moving_out_titan" } }
	}
	state = { name = "death" animation = "death" looping = no
        event = { trigger_once = yes sound = { soundeffect = "sfx_star_eater_weapon_hit" } }
        event = { trigger_once = yes sound = { soundeffect = "sfx_star_eater_weapon_hit_distance" } }
        event = { time = 1.0 node = "ship_main" particle = "spth_superlaser_hit_explosion" keep_particle = yes trigger_once = yes sound = { soundeffect = "hd2_vox_engine_explode_effect" } }
        event = { time = 2.5 node = "explosion_locator_01" particle = "th_explosion_purple_small" keep_particle = yes trigger_once = yes sound = { soundeffect = "station_explosion_energy" } }
        event = { time = 3.5 node = "explosion_locator_02" particle = "th_explosion_purple_small" keep_particle = yes trigger_once = yes sound = { soundeffect = "station_explosion_energy" } }
        event = { time = 5.5 node = "explosion_locator_03" particle = "th_explosion_purple_small" keep_particle = yes trigger_once = yes sound = { soundeffect = "station_explosion_energy" } }
        event = { time = 7.5 node = "explosion_locator_04" particle = "th_explosion_purple_small" keep_particle = yes trigger_once = yes sound = { soundeffect = "station_explosion_energy" } }
        event = { time = 9.5 node = "explosion_locator_05" particle = "th_explosion_purple_small" keep_particle = yes trigger_once = yes sound = { soundeffect = "station_explosion_energy" } }
        event = { time = 12.5 node = "ship_main" particle = "th_explosion_purple_large" keep_particle = yes trigger_once = yes sound = { soundeffect = "amb_fallen_empire_titan_death" } }
	}
	game_data = { size = 20 }
}

