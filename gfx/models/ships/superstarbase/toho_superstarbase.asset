entity = {
    name = "toho_superstarbase_ring_beam_entity"
    pdxmesh = "strg_empty_mesh"
    default_state = "idle"
    locator = { name = beam_root rotation = { 0 0 180 } position = { 0 0 0 } }
    locator = { name = muzzle_root rotation = { 0 0 180 } position = { 0 0 0 } }

    state = {
        name = "idle"
        event = { time = 0 node = "beam_root" particle = "matde_platform_small_beam_effect" keep_particle = yes trigger_once = yes }
        event = { time = 0 node = "muzzle_root" particle = "spth_mofazhen" keep_particle = yes trigger_once = yes }
    }
    scale = 0.1
}

