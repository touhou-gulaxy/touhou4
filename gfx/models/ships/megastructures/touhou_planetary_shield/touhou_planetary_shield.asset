@touhou_planetary_shield_scale = 1.32

entity = {
    name = "touhou_planetary_shield_blue_entity"
    pdxmesh = "touhou_gateway_ruin_shield_blue_mesh"

    scale = @touhou_planetary_shield_scale

    default_state = "idle"
    state = { name = "idle" state_time = 5
        start_event = { node = root particle = "touhou_special_shield_effect_blue" keep_particle = yes trigger_once = yes }
    }

    game_data = {
        bloom_factor = 0.25
        uv_animation_speed 		= 3.0
        uv_animation_direction 	= { 0.0 -0.02 }
    }
}
