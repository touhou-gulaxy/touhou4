entity = {
    name = "touhou_super_shipyard_core_part_2_entity"
    pdxmesh = "touhou_super_shipyard_core_part_2_mesh"

    default_state = "idle"
    state = {
        name = "idle" animation = "idle"
        # start_event = { node = "effect_1" particle = "matde_platform_beam_effect" keep_particle = yes trigger_once = yes }

        start_event = { node = "core" particle = "touhou_psionic_singularity_blue_titanic" keep_particle = yes trigger_once = yes }

        start_event = { node = "inner_beam_1" particle = "matde_core_small_beam_effect" keep_particle = yes trigger_once = yes }
        start_event = { node = "inner_beam_2" particle = "matde_core_small_beam_effect" keep_particle = yes trigger_once = yes }
        start_event = { node = "inner_beam_3" particle = "matde_core_small_beam_effect" keep_particle = yes trigger_once = yes }

        start_event = { node = "light_locator_01" particle = "ship_light_red_effect" keep_particle = yes trigger_once = yes }
        start_event = { node = "light_locator_02" particle = "ship_light_red_effect" keep_particle = yes trigger_once = yes }
        start_event = { node = "light_locator_03" particle = "ship_light_red_effect" keep_particle = yes trigger_once = yes }

        start_event = { trigger_once = yes sound = { soundeffect = "sfx_matter_decompressor_hum" } }
        start_event = { trigger_once = yes sound = { soundeffect = "sfx_matter_decompressor_hum_treble" } }
    }
}
entity = {
    name = "touhou_super_shipyard_core_part_1_shield_entity"
    pdxmesh = "touhou_gateway_ruin_shield_red_mesh"

    scale = 2.25

    default_state = "idle"
    state = { name = "idle" state_time = 5
        start_event = { node = root particle = "touhou_special_shield_effect_red" keep_particle = yes trigger_once = yes }
    }

    game_data = {
        bloom_factor = 0.25
        uv_animation_speed 		= 3.0
        uv_animation_direction 	= { 0.0 -0.02 }
    }
}
entity = {
    name = "touhou_super_shipyard_core_part_1_entity"
    pdxmesh = "touhou_super_shipyard_core_part_1_mesh"

    attach = { part1 = "touhou_super_shipyard_core_part_1_shield_entity" }
    default_state = "idle"
    state = { name = "idle" animation = "idle" animation_speed = 0.32
        start_event = { node = "part1" particle = "ship_aura_repairing_effect" keep_particle = yes trigger_once = yes }

        start_event = { trigger_once = yes sound = { soundeffect = "amb_titan_ship_hum_01" } }
    }
    game_data = {
        emissive_recolor_crunch = 2.0
    }
}
