    locator = { name = "DropletLocator7" position = { -13.5 0.4 -23.288 } }

    default_state = "idle"
    state = {
        name = "idle" animation = "idle" animation_speed = 0.2
        start_event = { trigger_once = yes sound = { soundeffect = "amb_star_eater_idle_hum" } }
        event = { time = 0 node = "DropletLocator0" particle = "touhou_cherry_blossom_petals_effect" trigger_once = yes keep_particle = yes }
