        event = { time = 0 node = "DropletLocator4" particle = "touhou_cherry_blossom_petals_effect" trigger_once = yes keep_particle = yes }
        event = { time = 0 node = "DropletLocator5" particle = "touhou_cherry_blossom_petals_effect" trigger_once = yes keep_particle = yes }
        event = { time = 0 node = "DropletLocator6" particle = "touhou_cherry_blossom_petals_effect" trigger_once = yes keep_particle = yes }
        event = { time = 0 node = "DropletLocator7" particle = "touhou_cherry_blossom_petals_effect" trigger_once = yes keep_particle = yes }
