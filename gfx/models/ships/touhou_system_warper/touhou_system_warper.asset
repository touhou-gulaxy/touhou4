        event = { time = 0 node = "light_locator_49" particle = "ship_light_pink_effect" keep_particle = yes trigger_once = yes }
        event = { time = 0 node = "light_locator_50" particle = "ship_light_pink_effect" keep_particle = yes trigger_once = yes }
    }

    game_data = {
        uv_animation_speed = 0.21
        emissive_recolor_crunch = 5.0
        #NOTE: Since the ship makes use of a flowmap, this is a special case
        #where the uv_animation_direction variable is used to determine the flowmap strength
        #instead of an animation direction.
        uv_animation_direction = { 0.3 0.0 }
        # size = 25
    }
}
