entity = {
    name = "touhou_system_warper_ring_1_entity"
    pdxmesh = "touhou_system_warper_ring_1_mesh"
    scale = 4

    locator = { name = "DropletLocator0" position = { 11.7 0.3 25 } }
    locator = { name = "DropletLocator1" position = { 14.9 0.31 21.39 } }
