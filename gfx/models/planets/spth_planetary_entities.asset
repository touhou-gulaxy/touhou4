entity = {
    name = "spth_empty_planet"
    pdxmesh = "locator_mesh"
}

entity = {
    name = "spth_test_planet"
    pdxmesh = "star_mesh"

    default_state = "idle"
    state = {
        name = "idle" looping = yes animation = "idle"
        event = { time = 0.0 particle = "spth_pink_class_star" keep_particle = no trigger_once = yes sound = { soundeffect = "pulsar_star_idle_hum" } }
        event = { trigger_once = yes sound = { soundeffect = "rift_idle" } }
    }
    locator = { name = "planet" }
    attach = { "planet" = "black_hole_rings_entity" }
    attach = { "planet" = "black_hole_grav_lens_entity" }
    attach = { "planet" = "black_hole_grav_animation_entity" }
    scale = 1.2
    game_data = {
        size = 1.0
        bloom_factor = 5
    }
}
