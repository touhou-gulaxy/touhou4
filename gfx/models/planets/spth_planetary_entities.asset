    # }
}
entity = {
    name = "touhou_non_revolve_black_hole_entity"
    pdxmesh = "strg_empty_mesh"

    scale = 5.0
    default_state = "idle"
    state = { name = "idle" state_time = 5
        event = { time = 0 particle = "touhou_singularity_black_hole_effect" trigger_once = yes keep_particle = yes }
        event = { trigger_once = yes sound = { soundeffect = "amb_star_eater_idle_hum" } }
    }
    locator = { name = "planet" }
    attach = { "planet" = "black_hole_rings_entity" }
    # attach = { "planet" = "black_hole_grav_lens_entity" }
    # attach = { "planet" = "black_hole_grav_animation_entity" }
    # attach = { "planet" = "pulsar_outbursts_entity" }

    game_data = {
        size = 1.0
        bloom_factor = 5
    }
    cull_radius = 700
}
entity = {
    name = "makai_ringworld_tech_entity_01_entity"
    cull_radius = 500.0
    pdxmesh = "ringworld_tech_01_mesh"

    default_state = "idle"
    state = { name = "idle"		state_time = 5
        event = { time = 0 node = "tech_1" particle = "ringworld_tech_particle" keep_particle = yes trigger_once = yes }
        #event = { time = 1 node = "tech_2" particle = "ringworld_tech_particle" keep_particle = yes trigger_once = yes }
        event = { time = 1 node = "tech_3" particle = "ringworld_tech_particle" keep_particle = yes trigger_once = yes }
    }
    state = { name = "construction"
    }

    meshsettings = {
        name = "pasted__polySurface28Shape"
        index = 0
        texture_diffuse = "ringworld_tech_diffuse.dds"
        texture_normal = "shroud_solid_normal.dds"
        texture_specular = "shroud_solid_specular.dds"
        shader = "PdxMeshExtraDimensionalShip"
    }

    game_data = {
        size = 50
        shader_type = ship
    }
}
entity = {
    name = "kamikakushi_planet_01_entity"
    pdxmesh = "planet_clouded_mesh"

    meshsettings = {
        name = "planet_geosphereShape"
        texture_diffuse = "spth_toxic_01_white_diffuse.dds"
        texture_normal = "toxic_01_normal.dds"
        texture_specular = "toxic_01_spec.dds"
        # shader = "PdxMeshExtraDimensionalShip"
    }

    ##pole texture override
    meshsettings = {
        name = "polesShape"
        texture_diffuse = "poles_1_diffuse.dds"
        texture_normal = "poles_1_normal.dds"
        texture_specular = "poles_1_specular.dds"
        # shader = "PdxMeshExtraDimensionalShip"
    }

    ##cloud texture override
    meshsettings = {
        name = "clouds_geosphereShape"
        texture_diffuse = "toxic_clouds_purple_diffuse.dds"
        texture_normal = "toxic_clouds_normal.dds"
        texture_specular = "toxic_clouds_specular.dds"
        # shader = "PdxMeshExtraDimensionalShip"
    }

    ##cloud shadow texture override
    meshsettings = {
        name = "clouds_shadow_geosphereShape"
        texture_diffuse = "toxic_cloud_shadow_diffuse.dds"
        texture_normal = "nonormal.dds"
        texture_specular = "nospec.dds"
        # shader = "PdxMeshExtraDimensionalShip"
    }

    default_state = "idle"
    state = {
        name = "idle" animation = "idle"
        #		event = { time = 0 node = "flash_01" particle = "planet_lightning_particle" keep_particle = yes }
        #		event = { time = 2 node = "flash_02" particle = "planet_lightning_particle" keep_particle = yes }
        #		event = { time = 0.7 node = "flash_03" particle = "planet_lightning_particle" keep_particle = yes }
        #		event = { time = 2.7 node = "flash_04" particle = "planet_lightning_particle" keep_particle = yes }
        #		event = { time = 3 node = "flash_05" particle = "planet_lightning_particle" keep_particle = yes }
        #		event = { time = 4.3 node = "flash_06" particle = "planet_lightning_particle" keep_particle = yes }
        #		event = { time = 7 node = "flash_07" particle = "planet_lightning_particle" keep_particle = yes }
        #		event = { time = 5 node = "flash_08" particle = "planet_lightning_particle" keep_particle = yes }
        #		event = { time = 5.1 node = "flash_09" particle = "planet_lightning_particle" keep_particle = yes }
        #		event = { time = 6.5 node = "flash_10" particle = "planet_lightning_particle" keep_particle = yes }
        start_event = { trigger_once = yes sound = { soundeffect = "amb_toxic_world_a" } }
        start_event = { trigger_once = yes sound = { soundeffect = "amb_toxic_world_b" } }
    }
}


