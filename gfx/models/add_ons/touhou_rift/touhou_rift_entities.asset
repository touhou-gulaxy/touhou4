entity = {
    name = "touhou_gap_rift_entity"
    pdxmesh = astral_scar_mesh_2
    locator = { name = "root" 	position = { 0 0 0 } }
    locator = { name = "rift" 	position = { 0 0 0 } rotation = { 90 90 0 } }
    locator = { name = "gap" 	position = { 0 0 0 } rotation = { 90 90 0 } }

    default_state = "idle"
    state = {
        name = "idle" animation = "astral_scar_idle" animation_speed = 0.4
        start_event = { particle = "touhou_gap_rift_particle" }
        start_event = { particle = "touhou_gap_rift_effect_eye" node = "gap" }
        start_event = { trigger_once = yes sound = { soundeffect = "crystal_idle" } }
    }
    attach = {
        rift = touhou_astral_rift_3_entity
        rift = touhou_astral_rift_5_entity
        rift = touhou_astral_rift_6_entity
    }
}
