            }
        }
        iconType = {
            name = "empire_info_bg"
            spriteType = "GFX_diplomacy_dark_fade_bg"
            position = { x = 0 y = @spth_hidden }
            alwaysTransparent = yes
        }
        instantTextBoxType = {
            name = "empire_name"
