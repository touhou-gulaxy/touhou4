guiTypes = {
    scrollbarType = {
        name = "touhou_toyohime_puzzle_standardlistbox_slider"
        slider = "listboxSliderButton"
        track = "listboxTrackButton"
        leftbutton = "upButton"
        rightbutton = "downButton"
        size = { x = 12 y = 12 }
        position = { x = 5 y = 0 }
        priority = 100
        borderSize = { x = 12 y = 12 }
        maxValue = 1
        minValue = 0
        stepSize = 0.01
        startValue = 0
        horizontal = 0

        guiButtonType = {
            name = "listboxSliderButton"
            quadTextureSprite = "GFX_ncp_scroll_slider"
            position = { x = 5 y = 0 }
        }

        guiButtonType = {
            name = "listboxTrackButton"
            quadTextureSprite = "GFX_spth_ncp_scroll_bg"
            position = { x = 12 y = 12 }
        }

        guiButtonType = {
            parent = "listboxSliderButton"
            name = "upButton"
            quadTextureSprite = "GFX_ncp_scroll_down"
            position = { x = 0 y = 0 }
        }

        guiButtonType = {
            parent = "listboxSliderButton"
            name = "downButton"
            quadTextureSprite = "GFX_ncp_scroll_up"
            position = { x = 0 y = 120 }
        }
    }
    # default button
    containerWindowType = {
        name = "touhou_toyohime_puzzle_button"
        position = { x = 0 y = 0 }
        size = { width = @spth_touhou_spellcard_button_w height = @spth_touhou_spellcard_button_h }
        moveable = no
        buttonType = {
            name = "option_button"
            quadTextureSprite = "GFX_spth_intel_record_icon_button"
            position = { x = 4 y = 4 }
            font = "spth_cg_16b"
            text = "OPTION_TEXT"
            text_offset = { x = 36 y = 0 }
            format = LEFT
        }
        OverlappingElementsBoxType = {
            name = "trigger_icons"
            position = { x = 244 y = 10 }
            size = { x = 36 y = 28 }
        }
    }
    # main gui
    containerWindowType = {
        name = "touhou_toyohime_puzzle_window"
        size = { width = 1200 height = 720 }
        moveable = yes
        orientation = center
        origo = center
        background = {
            name = "background"
            quadTextureSprite = "GFX_invisible"
            position = { x = 0 y = 0 }
        }
        containerWindowType = {
            name = "spth_event_window_background"
            orientation = UPPER_LEFT
            origo = UPPER_LEFT
            movable = no
            size = { width = 1200 height = 720 }
            background = {
                alwaysTransparent = yes
                name = "background"
                quadTextureSprite = "GFX_touhou_spellcard_tile_outliner_bg"
            }
        }
        # the portrait, actually room.
        containerWindowType = {
            name = "portrait"
            size = { width = 964 height = 350 }
            position = { x = 380 y = 55 }
            clipping = yes
            scale = @touhou_spellcard_portrait_scale
            iconType = {
                name = "portrait"
                position = { x = 0 y = 0 }
                spriteType = "GFX_portrait_gamesetup_mask"
                alwaysTransparent = yes
                scale = @touhou_spellcard_portrait_scale
            }
            iconType = {
                name = "black_frame"
                spriteType = "GFX_spth_event_frame"
                position = { x = -4 y = -5}
                alwaysTransparent = yes
                scale = @touhou_spellcard_portrait_scale
            }
            iconType = {
                name = "stripes_1"
                spriteType = "GFX_touhou_stripes_1"
                alwaysTransparent = yes
                scale = @touhou_spellcard_portrait_scale
            }
            iconType = {
                name = "city_frame"
                spriteType = "GFX_spth_event_frame"
                position = { x = -6 y = -5 }
                alwaysTransparent = yes
                scale = @touhou_spellcard_portrait_scale
            }
        }
        # basic info, or some text u want to show here.
        # hidden ui
        buttonType = {
            name = "tts_button"
            position = { x = 466 y = @spth_hidden }
            spriteType = "GFX_button_tts_start"
            buttonFont = "spth_cg_16b"
            shortCut = "t"
        }
        buttonType = {
            name = "close"
            quadTextureSprite = "GFX_close_button_planet"
            position = { x = 0 y = @spth_hidden }
            Orientation = "UPPER_RIGHT"
            clicksound = "back_click"
        }
        instantTextBoxType = {
            name = "heading"
            font = "spth_malgun_goth_24"
            text = "DIPLOMACY"
