guiTypes = {
    scrollbarType = {
        name = "spth_standardlistbox_slider"
        slider = "listboxSliderButton"
        track = "listboxTrackButton"
        leftbutton = "upButton"
        rightbutton = "downButton"
        size = { x = 12 y = 12 }
        position = { x = 5 y = 0 }
        priority = 100
        borderSize = { x = 12 y = 12 }
        maxValue = 1
        minValue = 0
