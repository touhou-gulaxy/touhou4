# size = 4 + 240 + 6 + 36 + 4 = 250 + 40 = 290
@spth_touhou_spellcard_button_w = 290
@spth_touhou_spellcard_button_h = 48
@spth_option_list_w = 300
@spth_option_list_bg_w = 310
@spth_hidden = 23333
@touhou_spellcard_info_x = 680
@touhou_spellcard_info_y = 350
@touhou_spellcard_info_w = 160
@touhou_spellcard_info_h = 300
@touhou_spellcard_x1_y = 345
@touhou_spellcard_x2_y = 495
@touhou_spellcard_1x_x = 380
@touhou_spellcard_2x_x = 530
@touhou_spellcard_3x_x = 890
@touhou_spellcard_4x_x = 1040
@touhou_spellcard_portrait_scale = 0.80
@touhou_spellcard_event_diplo_y = 540

guiTypes = {
    scrollbarType = {
        name = "spth_standardlistbox_slider"
        slider = "listboxSliderButton"
        track = "listboxTrackButton"
        leftbutton = "upButton"
        rightbutton = "downButton"
        size = { x = 12 y = 12 }
        position = { x = 5 y = 0 }
        priority = 100
        borderSize = { x = 12 y = 12 }
        maxValue = 1
        minValue = 0
        stepSize = 0.01
        startValue = 0
        horizontal = 0

        guiButtonType = {
            name = "listboxSliderButton"
            quadTextureSprite = "GFX_ncp_scroll_slider"
            position = { x = 5 y = 0 }
        }

        guiButtonType = {
            name = "listboxTrackButton"
            quadTextureSprite = "GFX_spth_ncp_scroll_bg"
            position = { x = 12 y = 12 }
        }

        guiButtonType = {
            parent = "listboxSliderButton"
            name = "upButton"
            quadTextureSprite = "GFX_ncp_scroll_down"
            position = { x = 0 y = 0 }
        }

        guiButtonType = {
            parent = "listboxSliderButton"
            name = "downButton"
            quadTextureSprite = "GFX_ncp_scroll_up"
            position = { x = 0 y = 120 }
        }
    }
    # default button
    containerWindowType = {
        name = "touhou_spellcard_ui_button"
        position = { x = 0 y = 0 }
        size = { width = @spth_touhou_spellcard_button_w height = @spth_touhou_spellcard_button_h }
        moveable = no
        buttonType = {
            name = "option_button"
            quadTextureSprite = "GFX_spth_intel_record_icon_button"
            position = { x = 4 y = 4 }
            font = "spth_cg_16b"
            text = "OPTION_TEXT"
            text_offset = { x = 36 y = 0 }
            format = LEFT
        }
        OverlappingElementsBoxType = {
            name = "trigger_icons"
            position = { x = 244 y = 10 }
            size = { x = 36 y = 28 }
        }
    }
    # GFX_button_animated_265_34 width = (867 - (6 * 12)) / 3 = 265
    # actual width = 265 + 12 * 2 = 289
    # GFX_touhou_button_animated_116 width = 116
    # actual width = 116 + 12 * 2 = 140
    # main gui
    containerWindowType = {
        name = "touhou_spellcard_ui_window"
        size = { width = 1200 height = 720 }
        moveable = yes
        orientation = center
        origo = center
        background = {
            name = "background"
            quadTextureSprite = "GFX_invisible"
            position = { x = 0 y = 0 }
        }
        containerWindowType = {
            name = "spth_event_window_background"
            orientation = UPPER_LEFT
            origo = UPPER_LEFT
            movable = no
            size = { width = 1200 height = 720 }
            background = {
                alwaysTransparent = yes
                name = "background"
                quadTextureSprite = "GFX_touhou_spellcard_tile_outliner_bg"
            }
        }
        # the portrait, actually room.
        containerWindowType = {
            name = "portrait"
            size = { width = 964 height = 350 }
            position = { x = 380 y = 55 }
            clipping = yes
            scale = @touhou_spellcard_portrait_scale
