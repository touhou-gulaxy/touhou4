            iconType = {
                name = "portrait"
                position = { x = 0 y = 0 }
                spriteType = "GFX_spth_intel_record_portrait_gamesetup_mask"
				# spriteType = "GFX_portrait_gamesetup_mask"
                # alwaysTransparent = yes
                # 635 / 340 = 1.86764705882
                scale = 1.8676
            }
            ####################### HIDDEN ########################
            iconType = {
                name = "city_frame"
                spriteType = "GFX_spth_event_frame"
                position = { x = 0 y = @spth_hidden }
                alwaysTransparent = yes
            }
