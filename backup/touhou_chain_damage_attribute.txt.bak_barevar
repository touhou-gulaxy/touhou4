# 连锁伤害取值：只做"名字拼接"，数值由 utils/gen_aoe_values.py 生成到
# common/scripted_variables/touhou_aoe_config.txt 的 GENERATED 区块
#     @touhou_chain_<name>_<tag>_<type>_min / _max
# 公式（在 scripted_variables 里算）：
#     ( spth_<name>_<tag>_<type>_damage_min + ..._damage_max ) / 4
#       * touhou_generic_scale_damage_<type>_factor * touhou_chain_dmg_(min|max)_factor
# 新增武器组合后跑一次：python3 utils/gen_aoe_values.py
chain_damage = {
	min = @touhou_chain_$name$_$tag$_$type$_min
	max = @touhou_chain_$name$_$tag$_$type$_max
}
chain_range = $range$
chain_count = $count$
